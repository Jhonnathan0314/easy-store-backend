# Copia este archivo a .env y completa los valores reales.
# docker-compose los inyecta automáticamente a los contenedores.

# --- Base de datos ---
EASY_STORE_DB_NAME=easy_store
EASY_STORE_DB_USER=root
EASY_STORE_DB_PASSWORD=12345
# Password del usuario root de MySQL (solo lo usa el contenedor de la BD)
EASY_STORE_DB_USER=root

# --- JWT ---
# Obligatoria. Debe ser una clave en Base64 de al menos 256 bits (32 bytes)
# para HS256; si falta o es invalida, el backend NO arranca (falla rapido
# con un mensaje explicito en vez de fallar en el primer login).
# Ejemplo para generar una: openssl rand -base64 32
SECRET_JWT_KEY=13E6E705C92D7EB0BDC507E38E5CDC9E1F1042A905CD2976DB71E40FEFAAFC4A

# --- AWS S3 (almacenamiento de imágenes) ---
EASY_STORE_AWS_S3_ACCESS_KEY=changeme
EASY_STORE_AWS_S3_SECRET_ACCESS_KEY=changeme
EASY_STORE_AWS_S3_EASY_STORE=changeme_bucket_name

# --- Usuario ghost (compra sin login) ---
EASY_STORE_GHOST_USER="ghost@gmail.com"
EASY_STORE_GHOST_PASSWORD="123456"

# --- Usuario admin por defecto ---
# Si se completan estos valores, el backend crea este usuario admin al
# arrancar (una sola vez, si no existe ya). Si se dejan vacios, no se crea
# ningun admin por defecto.
EASY_STORE_ADMIN_USER="admin@example.com"
EASY_STORE_ADMIN_PASSWORD=changeme

# --- Envío de correo (recuperación de contraseña) ---
EMAIL_APP_USERNAME=easy.pc.mail.info@gmail.com
EMAIL_APP_PASSWORD="wehd mxmv dwhh jqnr"